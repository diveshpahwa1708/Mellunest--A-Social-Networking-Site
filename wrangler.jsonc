{
  "name": "mellunest-project",
  "main": "backend/runtime/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mellunest-db",
      "database_id": "57f04d64-b7b1-4aed-9fbd-f38f06d130ab",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mellunest-media"
    }
  ]
}
